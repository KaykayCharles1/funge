pragma cashscript ^0.14.0;

// Throwaway probe. It checks, in the real compiler and VM, the facts the Kingdom contract will rely on.
contract ProbeKingdom(bytes32 pusdCategory) {
    // Fact 1: what a BCH-only input looks like to the script
    function bchOnlyInput() {
        require(tx.inputs[1].tokenCategory.length == 0, "category not empty");
        require(tx.inputs[1].tokenAmount == 0, "amount not 0");
        require(tx.inputs[1].nftCommitment.length == 0, "commitment not empty");
    }

    // Fact 2: the rounding rule (with an odd value, 1005)
    function mathRules(int value) {
        int fee = value * 2 / 100;
        int kingGets = value * 90 / 100 + fee;
        int poolGets = value + fee - kingGets;
        require(fee == 20, "fee");
        require(kingGets == 924, "kingGets");
        require(poolGets == 101, "poolGets");
    }

    // Fact 3: the 40-byte layout: passCount(4) holder(20) value(4) protects(1) previous(11)
    function layout() {
        bytes commitment = tx.inputs[0].nftCommitment;
        require(commitment.length == 40, "commitment length");
        int passCount = int(commitment.split(4)[0]);
        bytes holder = commitment.split(4)[1].split(20)[0];
        int value = int(commitment.split(24)[1].split(4)[0]);
        int protects = int(commitment.split(28)[1].split(1)[0]);
        bytes previous = commitment.split(29)[1];
        require(passCount == 3, "passCount");
        require(value == 1000, "value");
        require(protects == 2, "protects");
        require(previous.length == 11, "previous length");
        bytes rebuilt = toPaddedBytes(passCount + 1, 4) + holder + toPaddedBytes(value, 4) + toPaddedBytes(0, 1) + holder.split(11)[0];
        require(tx.outputs[0].nftCommitment == rebuilt, "rebuilt commitment");
    }

    // Fact 4: a payout must be plain PUSD (no NFT riding along)
    function payoutShape() {
        require(tx.outputs[2].tokenCategory == pusdCategory, "payout must be plain PUSD");
        require(tx.outputs[2].tokenAmount >= 920, "payout amount");
    }

    // Fact 5: input 2 must sit at the holder's address
    function holderInput(bytes20 holder) {
        require(tx.inputs[2].lockingBytecode == 0x76a914 + holder + 0x88ac, "input 2 must be the holder's");
    }
}