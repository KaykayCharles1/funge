pragma cashscript ^0.14.0;

// State commitment (24 bytes) = passCount (4 bytes, script number) + holderPkh (20 bytes)
contract FungeState(
    bytes potLockingBytecode,
    bytes32 pusdCategory,
    int basePrice,
    int priceStep,
    int timeoutBlocks
) {
    function pass(bytes20 newHolder) {
        require(this.activeInputIndex == 0, "State must be input 0");
        require(tx.inputs[1].lockingBytecode == potLockingBytecode, "Input 1 must be the pot");
        require(tx.inputs[1].tokenCategory == pusdCategory, "Pot must hold PUSD");

        int passCount = int(tx.inputs[0].nftCommitment.split(4)[0]);
        int price = basePrice + passCount * priceStep;

        require(tx.outputs[0].lockingBytecode == tx.inputs[0].lockingBytecode, "Output 0 must be the state contract");
        require(tx.outputs[0].tokenCategory == tx.inputs[0].tokenCategory, "State NFT must be kept");
        require(tx.outputs[0].tokenAmount == tx.inputs[0].tokenAmount, "State token amount changed");
        require(tx.outputs[0].nftCommitment == toPaddedBytes(passCount + 1, 4) + newHolder, "Bad new commitment");
        require(tx.outputs[0].value >= tx.inputs[0].value, "State BCH shrank");

        require(tx.outputs[1].lockingBytecode == potLockingBytecode, "Output 1 must be the pot");
        require(tx.outputs[1].tokenCategory == pusdCategory, "Pot output must hold PUSD");
        require(tx.outputs[1].tokenAmount >= tx.inputs[1].tokenAmount + price, "Price not paid");
        require(tx.outputs[1].value >= tx.inputs[1].value, "Pot BCH shrank");
    }

    function settle() {
        require(this.activeInputIndex == 0, "State must be input 0");
        require(this.age >= timeoutBlocks);
        require(tx.inputs[1].lockingBytecode == potLockingBytecode, "Input 1 must be the pot");
        require(tx.inputs[1].tokenCategory == pusdCategory, "Pot must hold PUSD");

        bytes holderPkh = tx.inputs[0].nftCommitment.split(4)[1];
        bytes holderLock = 0x76a914 + holderPkh + 0x88ac;

        require(tx.outputs[0].lockingBytecode == holderLock, "Pot must go to the holder");
        require(tx.outputs[0].tokenCategory == pusdCategory, "Payout must be PUSD");
        require(tx.outputs[0].tokenAmount == tx.inputs[1].tokenAmount, "Whole pot must be paid");

        bytes gameCategory = tx.inputs[0].tokenCategory.split(32)[0];
        require(tx.outputs[1].lockingBytecode == holderLock, "Trophy must go to the holder");
        require(tx.outputs[1].tokenCategory == gameCategory, "Trophy must be immutable");
        require(tx.outputs[1].nftCommitment == tx.inputs[0].nftCommitment, "Trophy commitment changed");
        require(tx.outputs[1].tokenAmount == 0, "Trophy must carry no tokens");
    }
}